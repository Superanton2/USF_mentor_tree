{
  "name": "mentor-tree",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mentor-tree/web-app",
    "sync": "npm run sync --workspace @mentor-tree/sync-service --",
    "sync:rollback": "npm run sync:rollback --workspace @mentor-tree/sync-service",
    "generate-demo-data": "tsx scripts/generateDemoData.ts",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @mentor-tree/web-app",
    "lint": "eslint . && tsx scripts/checkForbiddenFileNames.ts && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:data": "tsx scripts/checkNoRealData.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
