# Copy to .env (never commit). Without .env the stack starts on demo data.
DATA_SOURCE=csv
CSV_DIRECTORY=data/demo
# DATA_SOURCE=google-sheets
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/run/secrets/google-service-account.json
SITE_BASE_URL=http://localhost:8080
PUBLISH_POLL_INTERVAL_MINUTES=10
RELEASES_TO_KEEP=5
ALLOW_SEARCH_INDEXING=false
WEB_PORT=8080
# How often the sync container checks the CSV files for changes
CSV_POLL_INTERVAL_SECONDS=10
