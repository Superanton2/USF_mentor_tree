FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/domain/package.json packages/domain/package.json
COPY packages/sync-service/package.json packages/sync-service/package.json
COPY packages/web-app/package.json packages/web-app/package.json
RUN npm ci --omit=dev --workspace @mentor-tree/sync-service

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json ./
COPY packages/domain ./packages/domain
COPY packages/sync-service ./packages/sync-service
COPY data/reference ./data/reference
COPY data/demo ./data/demo
# Publishes at start and again whenever the data files change (no container re-creation needed).
# Stage 6 swaps the file check for polling the spreadsheet's "publish" checkbox.
CMD ["node_modules/.bin/tsx", "packages/sync-service/src/cli/watchCommand.ts"]
